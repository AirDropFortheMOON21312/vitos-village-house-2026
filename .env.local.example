# ─── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... during development, sk_live_... / pk_live_... in production
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook secret — generated when you register the webhook endpoint in Stripe dashboard
# Or locally: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (email) ────────────────────────────────────────────────────────────
# Free tier: 100 emails/day. Sign up at https://resend.com
# IMPORTANT: verify your domain (vitosvillagehouse.com) in Resend dashboard first
RESEND_API_KEY=re_...

# ─── App URL ───────────────────────────────────────────────────────────────────
# No trailing slash. Used for Stripe redirect URLs.
NEXT_PUBLIC_BASE_URL=https://vitos-village-house.com
